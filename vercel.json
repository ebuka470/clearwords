{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/language.html"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/language",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/language.html",
      "destination": "/app",
      "permanent": true
    }
  ],
"headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}